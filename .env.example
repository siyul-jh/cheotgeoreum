# NVIDIA NIM (기본값). 키는 https://build.nvidia.com 에서 발급해 .env에 넣는다.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# 아이디어 추천만 다른 모델로(비우면 LLM_MODEL)
LLM_IDEAS_MODEL=minimaxai/minimax-m3.1-flash

# 로컬 LLM 예시 (OpenAI 호환 /v1, 키는 비워 둬도 된다)
# Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LM Studio
# LLM_BASE_URL=http://localhost:1234/v1
