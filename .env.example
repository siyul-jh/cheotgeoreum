# NVIDIA NIM (기본값). 키는 https://build.nvidia.com 에서 발급해 .env에 넣는다.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# 아이디어 추천만 다른 모델로(비우면 LLM_MODEL)
LLM_IDEAS_MODEL=minimaxai/minimax-m3.1-flash

# 로컬 LLM 예시 (OpenAI 호환 /v1, 키는 비워 둬도 된다)
# Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LM Studio
# LLM_BASE_URL=http://localhost:1234/v1

# 계정 연결(선택 로그인). Neon pooled URL(-pooler)
DATABASE_URL=
# Better Auth: 32자 이상 임의 문자열, 배포 주소(예: https://example.vercel.app)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 기능 요청 → GitHub 이슈. fine-grained 토큰(siyul-jh/cheotgeoreum 한 리포, Issues: Read and write만)
GITHUB_ISSUES_TOKEN=

# 알림(웹 푸시). 키 쌍은 `npx web-push generate-vapid-keys`로 만든다. 공개키는 앱 번들에 들어가도 된다
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알리는 연락처(https 주소 또는 mailto:). 비우면 앱 주소
VAPID_SUBJECT=
# Vercel 크론 인증(16자 이상 임의 문자열). Vercel이 Authorization: Bearer로 붙여 준다
CRON_SECRET=
